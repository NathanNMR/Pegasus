# Copie para /etc/pegasus.env, preencha e proteja:  sudo chmod 600 /etc/pegasus.env
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PEGASUS_DATA_DIR=/var/lib/pegasus
# 1 proxy confiável na frente (Caddy). Sem isso o limite de login vale para todos juntos.
PEGASUS_TRUST_PROXY=1
# Gere com:  openssl rand -hex 32     (GUARDE UMA CÓPIA: sem a chave as mensagens não podem ser lidas)
PEGASUS_MESSAGE_KEY=
