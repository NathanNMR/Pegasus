# Copie para /etc/pegasus.env (VM própria) ou use como referência no painel do Render.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PEGASUS_DATA_DIR=/var/lib/pegasus
# 1 proxy confiável na frente (Caddy/Render). Sem isso o limite de login vale para todos juntos.
PEGASUS_TRUST_PROXY=1
# Gere com:  openssl rand -hex 32     (GUARDE UMA CÓPIA: sem a chave as mensagens não podem ser lidas)
PEGASUS_MESSAGE_KEY=
# URI do PostgreSQL (Aiven: Overview → Service URI)
DATABASE_URL=postgres://USUARIO:SENHA@HOST:PORTA/defaultdb
# Conteúdo do ca.pem do Aiven (recomendado). Aceita quebras de linha reais ou \n literais.
PG_CA_CERT=
